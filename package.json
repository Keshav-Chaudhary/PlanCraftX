{
  "name": "PlanCraftX-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/generate-csp-hashes.mjs --update && prettier --write firebase.json",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run tests/security",
    "test:e2e": "playwright test",
    "size-limit": "size-limit",
    "knip": "knip",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "hygiene": "node scripts/repo-hygiene.mjs",
    "verify": "node scripts/verify-all.mjs",
    "deploy": "next build --webpack && firebase deploy --only hosting",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@upstash/redis": "^1.34.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.50.1",
    "@size-limit/file": "^11.1.6",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^5.44.0",
    "lint-staged": "^15.4.3",
    "msw": "^2.7.0",
    "postcss": "^8.5.31",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "serve": "^14.2.6",
    "size-limit": "^11.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": {
      "braces": "3.0.3"
    },
    "fast-glob": {
      "micromatch": "^4.0.8"
    },
    "sharp": ">=0.35.5",
    "qs": ">=6.15.4",
    "tmp": "^0.2.6"
  }
}
