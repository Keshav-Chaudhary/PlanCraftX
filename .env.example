# Google Gemini AI Configuration (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis Distributed Rate Limiting (Optional - Falls back to local in-memory sliding window)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstream Services Base URLs (Defaults point to verified production hosts)
FRANKFURTER_BASE_URL=https://api.frankfurter.app
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
NAGER_DATE_BASE_URL=https://date.nager.at
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de

# Test-Only Upstream Stub Override (Strictly rejected when NODE_ENV=production or VERCEL_ENV is set)
E2E_UPSTREAM_BASE_URL=
